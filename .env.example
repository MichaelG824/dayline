# Copy to .env and fill in.

# Supabase project (Settings -> API in the Supabase dashboard). Use the
# service_role key, never the anon key - this backend is the only client and
# runs server-side only (see supabase/schema.sql's RLS posture).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Backs the chat propose/confirm feature (api/chat.py).
ANTHROPIC_API_KEY=your_anthropic_api_key

# Sign-in. AUTH_SECRET must be a long random string and stay stable across
# process restarts (scale-to-zero hosts boot a new process on each cold start).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=change-me-to-a-long-random-string
# The one Google account that may use Dayline (ownership is proven by sign-in).
ALLOWED_EMAIL=

# Google OAuth *Web application* client (APIs & Services -> Credentials).
# Authorized redirect URIs must include {PUBLIC_URL}/api/auth/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public origin the browser uses. Local default is the Next.js dev server.
# Production: the Cloud Run / Render https URL, no trailing slash.
PUBLIC_URL=http://localhost:3000

# Optional. Defaults to {PUBLIC_URL}/api/auth/callback.
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Optional. Extra CORS origins, comma-separated. Same-origin production does
# not need this.
# CORS_ORIGINS=

# Optional. Production Google Calendar (interviews only). The desktop
# credentials.json / token.json flow cannot survive scale-to-zero. Paste the
# refresh_token from a one-time local connect (see GOOGLE_SETUP.md).
# GOOGLE_CALENDAR_REFRESH_TOKEN=
