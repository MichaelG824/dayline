<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Notes board" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag :app %>
  </head>
  <body>
    <main>
      <% if notice %><p class="notice"><%= notice %></p><% end %>
      <%= yield %>
    </main>
  </body>
</html>
